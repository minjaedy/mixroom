      "database_id": "166a4316-3896-4cba-ada2-03dfa47117b6",
      "migrations_dir": "audio-migrations"
    },
    {
      "binding": "AUDIO_DB_2",
      "database_name": "mixroom-audio-2",
      "database_id": "01bbdc36-6012-4eca-ac5f-20289462f7b5",
      "migrations_dir": "audio-migrations"
    },
    {
      "binding": "AUDIO_DB_3",
      "database_name": "mixroom-audio-3",
      "database_id": "f4cb3ac8-f7f7-49bc-8bcd-dea69e4faad0",
